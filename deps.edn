{:paths ["src"]
 ;; jolt-lang/glimmer main after #15. glimmer-qt needs its backend lifecycle seam
 ;; (#13, see LIFECYCLE.md).
 :deps {jolt-lang/glimmer {:git/url "https://github.com/jolt-lang/glimmer"
                           :git/sha "22350c4d047b05359a16b756b20f38ecb391a63b"}}
 :aliases {:counter {:extra-paths ["examples"] :main-opts ["-m" "glimmer-qt.counter"]}
           :hello {:extra-paths ["examples"] :main-opts ["-m" "glimmer-qt.hello"]}
           :dialogs-test {:extra-paths ["test"] :main-opts ["-m" "glimmer-qt.dialogs-test"]}
           :controls-test {:extra-paths ["test"] :main-opts ["-m" "glimmer-qt.controls-test"]}
           :text-test {:extra-paths ["test"] :main-opts ["-m" "glimmer-qt.text-test"]}
           :keyboard-test {:extra-paths ["test"] :main-opts ["-m" "glimmer-qt.keyboard-test"]}
           :pointer-test {:extra-paths ["test"] :main-opts ["-m" "glimmer-qt.pointer-test"]}
           :actions-test {:extra-paths ["test"] :main-opts ["-m" "glimmer-qt.actions-test"]}
           :tray-test {:extra-paths ["test"] :main-opts ["-m" "glimmer-qt.tray-test"]}
           :layout-test {:extra-paths ["test"] :main-opts ["-m" "glimmer-qt.layout-test"]}
           :windows-test {:extra-paths ["test"] :main-opts ["-m" "glimmer-qt.windows-test"]}
           :objects-test {:extra-paths ["test"] :main-opts ["-m" "glimmer-qt.objects-test"]}
           :values-test {:extra-paths ["test"] :main-opts ["-m" "glimmer-qt.values-test"]}
           :media-test {:extra-paths ["test"] :main-opts ["-m" "glimmer-qt.media-test"]}
           :services-test {:extra-paths ["test"] :main-opts ["-m" "glimmer-qt.services-test"]}
           :scheduling-test {:extra-paths ["test"] :main-opts ["-m" "glimmer-qt.scheduling-test"]}
           :test {:extra-paths ["test"] :main-opts ["-m" "glimmer-qt.lifecycle-test"]}}
 :tasks {test {:doc "Run all automated suites, or a named suite (see --list)"
               :task (apply shell "./bin/test" *command-line-args*)}
         counter "./bin/run-example counter"
         hello "./bin/run-example hello"}
 :jolt/native [{:name "glimmer-qt"
                :darwin ["libglimmer_qt.dylib"
                         "build/libglimmer_qt.dylib"]
                :windows ["build/release/glimmer_qt.dll" "build/glimmer_qt.dll"]
                :linux ["build/libglimmer_qt.so"]}]}
