#!/usr/bin/env sh
# Parallelism for the native library and test fixtures.
set -eu

JOBS="${GLIMMER_QT_BUILD_JOBS:-}"
if [ -z "$JOBS" ]; then
    if command -v nproc >/dev/null 2>&1; then
        JOBS="$(nproc 2>/dev/null || echo 1)"
    elif command -v sysctl >/dev/null 2>&1; then
        JOBS="$(sysctl -n hw.ncpu 2>/dev/null || echo 1)"
    else
        JOBS=1
    fi
fi

case "$JOBS" in
    ''|*[!0-9]*) echo 'GLIMMER_QT_BUILD_JOBS must be a positive integer.' >&2; exit 1 ;;
esac
if ! [ "$JOBS" -gt 0 ] 2>/dev/null; then
    echo 'GLIMMER_QT_BUILD_JOBS must be a positive integer.' >&2
    exit 1
fi
printf '%s\n' "$JOBS"
