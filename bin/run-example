#!/usr/bin/env python3
"""Build and launch one of the introductory examples."""

import argparse
import os

from qt import ROOT, build_environment, cli, jolt


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("example", choices=("counter", "hello"))
    args = parser.parse_args()
    runtime = jolt()
    env = build_environment()
    os.chdir(ROOT)
    os.execve(runtime, [runtime, f"-M:{args.example}"], env)


if __name__ == "__main__":
    raise SystemExit(cli(main))
