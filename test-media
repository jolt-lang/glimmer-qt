#!/usr/bin/env sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
"$ROOT/build-native"
QMAKE="$(cat "$ROOT/build/qmake-path")"
export QT_PLUGIN_PATH="${QT_PLUGIN_PATH:-$("$QMAKE" -query QT_INSTALL_PLUGINS)}"
export QML_IMPORT_PATH="$("$QMAKE" -query QT_INSTALL_QML)"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-offscreen}"
export QT_MEDIA_BACKEND="${QT_MEDIA_BACKEND:-ffmpeg}"
# Offscreen verification exercises decoding and sink delivery without a GPU.
if [ "$QT_QPA_PLATFORM" = offscreen ]; then
  export QT_FFMPEG_DECODING_HW_DEVICE_TYPES="${QT_FFMPEG_DECODING_HW_DEVICE_TYPES:-,}"
fi
python3 - "$("$QMAKE" -query QT_INSTALL_PLUGINS)" <<'PYTHON'
import os, pathlib, sys
if os.environ['QT_MEDIA_BACKEND'] == 'ffmpeg':
    roots = [sys.argv[1], *os.environ['QT_PLUGIN_PATH'].split(os.pathsep)]
    if not any(list((pathlib.Path(root) / 'multimedia').glob('*ffmpegmediaplugin*')) for root in roots if root):
        sys.exit('Qt FFmpeg multimedia plugin is required; select an SDK containing it with GLIMMER_QT_QMAKE, or set QT_PLUGIN_PATH to a compatible plugin installation.')
PYTHON
CLIP_DIR="$(mktemp -d)"
trap 'rm -rf "$CLIP_DIR"' EXIT
ffmpeg -hide_banner -loglevel error -y -f lavfi -i color=c=red:s=160x90:r=1 \
  -f lavfi -i sine=frequency=440:sample_rate=44100 -t 3 -c:v libx264 \
  -pix_fmt yuv420p -c:a aac -shortest "$CLIP_DIR/static.mp4"
cd "$ROOT"
if ! python3 - "${JOLT:-jolt}" "$CLIP_DIR/static.mp4" > "$CLIP_DIR/result.log" 2>&1 <<'PYTHON'
import subprocess, sys
try:
    sys.exit(subprocess.run([sys.argv[1], '-M:media-test', sys.argv[2]], timeout=60).returncode)
except subprocess.TimeoutExpired:
    sys.exit('Qt media tests exceeded 60 seconds')
PYTHON
then
  tail -n 40 "$CLIP_DIR/result.log" >&2
  exit 1
fi
python3 - "$CLIP_DIR/result.log" <<'PY'
import pathlib, sys
log = pathlib.Path(sys.argv[1]).read_text()
for line in log.splitlines():
    if line.startswith('PASS:'):
        print(line)
        break
else:
    sys.exit('Media verification did not report completion')
PY
